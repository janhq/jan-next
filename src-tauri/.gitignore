# Generated by Cargo
# will have compiled files and executables
/target/
# Regenerated by every tauri build; capabilities/*.json point at its schemas
/gen/

# Autogenerated plugin permissions
plugins/*/permissions/autogenerated/

# Runtime agent thread data (created when running `jan agent` from src-tauri/)
/threads/
# Pending insta snapshots; accept with `cargo insta review` (see CONTRIBUTING.md)
*.snap.new
