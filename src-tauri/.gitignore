# Generated by Cargo
# will have compiled files and executables
/target/
# Regenerated by every tauri build; capabilities/*.json point at its schemas
/gen/

# Autogenerated plugin permissions
plugins/*/permissions/autogenerated/

# Pending insta snapshots; accept with `cargo insta review`
*.snap.new

# Standalone plugin/utils lockfiles; the app build resolves through /Cargo.lock
plugins/*/Cargo.lock
utils/Cargo.lock
