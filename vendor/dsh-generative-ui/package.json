{
  "name": "@janhq/dsh-generative-ui",
  "version": "0.2.0",
  "description": "Generative UI (UI4A): the agent writes TSX that renders live, inline in chat and in a canvas panel",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "vendor/dsh-generative-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "types",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "keywords": [
    "generative-ui",
    "ui4a",
    "jan-plugin",
    "cordis-plugin"
  ],
  "jan": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esm.sh/tsx": "^1.5.3",
    "@unocss/core": "^66.8.1",
    "@unocss/preset-wind4": "^66.8.1",
    "partial-react": "~0.0.10",
    "partial-tsx": "~0.0.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:@janhq/cordis@*",
    "@deepseek-ai/schemastery": "workspace:@janhq/schemastery@*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:@janhq/jan-api-session-controller@*",
    "@deepseek-ai/dsh-client-locale": "workspace:@janhq/jan-client-locale@*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:@janhq/jan-client-ui-conversation@*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:@janhq/jan-client-ui-layout@*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:@janhq/jan-client-ui-primitives@*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:@janhq/jan-client-ui-session@*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:@janhq/jan-client-ui-sidebar-right@*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:@janhq/jan-client-ui-slots@*",
    "@deepseek-ai/dsh-host-webserver": "workspace:@janhq/jan-host-webserver@*",
    "@deepseek-ai/dsh-llm": "workspace:@janhq/jan-llm@*",
    "@deepseek-ai/dsh-settings": "workspace:@janhq/jan-settings@*",
    "@deepseek-ai/dsh-skill": "workspace:@janhq/jan-skill@*",
    "@deepseek-ai/dsh-system-prompt": "workspace:@janhq/jan-system-prompt@*",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:@janhq/jan-util-workspace-path@*",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/scheduler": "^0.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "scheduler": "^0.23.2",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3"
  }
}
