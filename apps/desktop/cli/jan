#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
case "$(uname -s)" in
  Darwin) executable="$resources/../MacOS/Jan Alpha" ;;
  *) executable="$resources/../jan-alpha" ;;
esac
ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$resources/app.asar/jan/node_modules/@janhq/jan-desktop-host/lib/cli.js" "$@"
