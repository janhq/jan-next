# Copy to production.env and configure the production service before selecting this preset.
JAN_DESKTOP_APP_ID=com.janhq.jan
JAN_DESKTOP_AUTO_UPDATE_ENV=production
JAN_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
JAN_DESKTOP_MACOS_PACK_CONCURRENCY=4
JAN_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
JAN_DESKTOP_MACOS_DOWNLOAD_PROXY=
JAN_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# JAN_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
