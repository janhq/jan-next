# Copy to production.env in the same machine configuration directory and fill in the values.
JAN_DESKTOP_APP_ID=com.janhq.jan
JAN_DESKTOP_AUTO_UPDATE_ENV=production
JAN_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
JAN_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# JAN_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
JAN_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
JAN_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
