{
  "name": "@janhq/jan-desktop-app",
  "description": "The Jan desktop bundle: the Jan theme, the read-only import of chats from the earlier Jan desktop app, the Preset Square catalog and the Downloads page over jan-web-app",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@janhq/jan-client-ui-jan-theme": "workspace:*",
    "@janhq/jan-downloads": "workspace:*",
    "@janhq/jan-legacy-import": "workspace:*",
    "@janhq/jan-model-hub": "workspace:*",
    "@janhq/jan-preset-square": "workspace:*"
  }
}
