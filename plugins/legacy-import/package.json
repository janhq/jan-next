{
  "name": "@janhq/jan-legacy-import",
  "version": "0.2.2-rc.1",
  "private": true,
  "description": "Read-only import of chats from the earlier Jan desktop app, and of Claude Code, Codex and OMP sessions, into Jan sessions, from Settings or a /migrate chat.",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-plugin-api": "workspace:*",
    "@janhq/jan-skill": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/jan-session-format-v3-to-v4": "workspace:*"
  },
  "jan": {
    "client": {
      "platform": "web",
      "inject": [
        "@janhq/jan-client-ui-layout",
        "@janhq/jan-client-ui-primitives",
        "@janhq/jan-client-ui-settings-plugins",
        "@janhq/jan-client-ui-workspace"
      ]
    }
  }
}
