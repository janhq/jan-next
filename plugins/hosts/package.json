{
  "name": "@janhq/jan-hosts",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Save other Jan Hosts by URL or SSH, test and open them, and pair phones and other devices with this Host by QR code.",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["*.mjs", "client.js", "README.md"],
  "dependencies": {
    "@janhq/jan-atomic-write": "workspace:*",
    "@janhq/jan-plugin-api": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "uqr": "^0.1.3",
    "ws": "^8.21.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "jan": {
    "client": {
      "platform": "web",
      "inject": ["@janhq/jan-client-ui-primitives"]
    }
  }
}
