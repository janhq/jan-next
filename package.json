{
  "name": "jan-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "core",
      "web-app"
    ]
  },
  "scripts": {
    "lint": "yarn workspace @janhq/web-app lint",
    "dev": "yarn dev:tauri",
    "build": "yarn build:tauri",
    "test": "yarn test:core && yarn test:web",
    "test:core": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --project @janhq/core",
    "test:web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --project @janhq/web-app",
    "test:all": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:ui": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --ui",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "dev:web": "yarn workspace @janhq/web-app dev",
    "dev:tauri": "yarn build:icon && yarn copy:assets:tauri && tauri dev",
    "copy:assets:tauri": "cpx \"LICENSE\" \"src-tauri/resources/\"",
    "download:bin": "node ./src-tauri/build-utils/download-bin.mjs",
    "build:tauri:win32": "yarn download:bin && yarn tauri build",
    "build:tauri:darwin": "yarn download:bin && yarn tauri build --target universal-apple-darwin",
    "build:tauri": "yarn build:icon && yarn copy:assets:tauri && run-script-os",
    "build:tauri:plugin:api": "cd src-tauri/plugins && yarn install && yarn workspaces foreach -Apt run build",
    "build:icon": "tauri icon ./src-tauri/icons/macos/icon.png -o ./src-tauri/icons/macos && tauri icon ./src-tauri/icons/icon.png && node ./src-tauri/build-utils/build-windows-icon.mjs",
    "build:core": "cd core && yarn build && yarn pack",
    "build:web": "yarn workspace @janhq/web-app build",
    "build:dsh": "node dsh/build.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "run-script-os": "^1.1.6",
    "tar": "^7.5.22",
    "unzipper": "^0.12.3",
    "vitest": "^3.2.7"
  },
  "version": "0.0.0",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "resolutions": {
    "lru-cache/yallist": "4.0.0",
    "compression": "^1.8.2",
    "tinypool": "^2.1.2",
    "lodash-es": "^4.18.1",
    "serve-handler": "6.1.7",
    "@ai-sdk/provider-utils@npm:3.0.18": "3.0.28",
    "@ai-sdk/provider-utils@npm:4.0.27": "4.0.33",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2"
  },
  "packageManager": "yarn@4.5.3"
}
