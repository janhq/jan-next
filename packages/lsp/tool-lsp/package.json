{
  "name": "@janhq/jan-tool-lsp",
  "description": "Model-facing lsp tool over the Jan LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-lsp": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-lsp": "workspace:*",
    "@janhq/jan-lsp-stdio": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-call-timeout-policy": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*"
  }
