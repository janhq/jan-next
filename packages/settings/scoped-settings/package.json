{
  "name": "@janhq/jan-scoped-settings",
  "description": "Model, mode and tool switches that resolve per chat, then per project, then globally",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/settings/scoped-settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "jan": {
    "client": {
      "inject": [
        "@janhq/jan-api-remotes",
        "@janhq/jan-client-locale",
        "@janhq/jan-client-ui-commands",
        "@janhq/jan-client-ui-context-menu",
        "@janhq/jan-client-ui-layout",
        "@janhq/jan-client-ui-renderer",
        "@janhq/jan-client-ui-settings",
        "@janhq/jan-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/types.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-mcp-client": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-atomic-write": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-preset-registry": "workspace:*",
    "@janhq/jan-api-remotes": "workspace:*",
    "@janhq/jan-api-session-controller": "workspace:*",
    "@janhq/jan-client-locale": "workspace:*",
    "@janhq/jan-client-store": "workspace:*",
    "@janhq/jan-client-test-runtime": "workspace:*",
    "@janhq/jan-client-ui-agent-preset": "workspace:*",
    "@janhq/jan-client-ui-commands": "workspace:*",
    "@janhq/jan-client-ui-context-menu": "workspace:*",
    "@janhq/jan-client-ui-layout": "workspace:*",
    "@janhq/jan-client-ui-primitives": "workspace:*",
    "@janhq/jan-client-ui-renderer": "workspace:*",
    "@janhq/jan-client-ui-settings": "workspace:*",
    "@janhq/jan-client-ui-slots": "workspace:*",
    "@janhq/jan-client-ui-workspace": "workspace:*",
    "@janhq/jan-mcp-client": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-skill": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-workspace": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0"
  }
}
