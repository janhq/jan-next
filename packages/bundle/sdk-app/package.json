{
  "name": "@janhq/jan-sdk-app",
  "description": "The jan SDK profile bundle: stdio JSON-RPC serving and process lifecycle over jan-base",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@janhq/jan-cmdline": "workspace:*",
    "@janhq/jan-sdk-jsonrpc-server": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@janhq/jan-skill-office": "workspace:*",
    "@janhq/jan-tool-workspace-dependencies": "workspace:*",
    "@janhq/jan-client-connection": "workspace:*",
    "@janhq/jan-client-file-upload": "workspace:*",
    "@janhq/jan-workspace": "workspace:*",
    "@janhq/jan-schedule": "workspace:*",
    "@janhq/jan-time-context": "workspace:*",
    "@janhq/jan-tool-schedule": "workspace:*",
    "@janhq/jan-tool-ask-user": "workspace:*",
    "@janhq/jan-tool-present": "workspace:*",
    "@janhq/jan-file-reference-local": "workspace:*",
    "@janhq/jan-deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis": "workspace:~"
  }
}
