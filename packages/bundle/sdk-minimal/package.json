{
  "name": "@janhq/jan-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, the Tokamak model route, persistent shell, and JSONL sessions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@janhq/cordis-plugin-timer": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-attachment-local": "workspace:*",
    "@janhq/jan-compaction-basic": "workspace:*",
    "@janhq/jan-compaction-image-offload": "workspace:*",
    "@janhq/jan-jobs-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-llm-retry": "workspace:*",
    "@janhq/jan-mcp-resources": "workspace:*",
    "@janhq/jan-sandbox-local": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-sdk-app": "workspace:*",
    "@janhq/jan-sdk-jsonrpc-server": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-checkpoint-policy": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-session-title": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-terminal": "workspace:*",
    "@janhq/jan-terminal-bash": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-tool-bash-persistent": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-fs": "workspace:*",
    "@janhq/jan-tool-pwsh-persistent": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/jan-tool-working-directory": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~"
  }
}
