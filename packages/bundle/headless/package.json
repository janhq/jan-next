{
  "name": "@janhq/jan-headless",
  "description": "The jan one-shot bundle: a direct core Agent/Session runner over jan-base with no Host, HTTP, or browser layer",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-cmdline": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-default-model": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-query": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-permission-presets": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-default-model": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-query": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-permission-presets": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-permission-presets": {
      "optional": true
    },
    "@janhq/jan-sandbox-policy": {
      "optional": true
    },
    "@janhq/jan-subagent": {
      "optional": true
    }
  }
}
