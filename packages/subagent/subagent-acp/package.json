  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-timeout": "workspace:*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-app-boot": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-loader-smoke": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-checkpoint-policy": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-subagent": "workspace:*"
  }
