{
  "name": "@janhq/jan-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "4.4.3",
    "@janhq/jan-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-app-boot": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-loader-smoke": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-checkpoint-policy": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subagent-codex": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-jobs": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}
