{
  "name": "@janhq/jan-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-timeout": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-sdk-protocol": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@janhq/jan-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-app-boot": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-loader-smoke": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-checkpoint-policy": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-jobs": "workspace:*",
    "@janhq/jan-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
