{
  "name": "@janhq/jan-sdk-client",
  "description": "TypeScript client SDK for driving a Jan runtime subprocess over stdio JSON-RPC: the Jan high-level turns API and the lower-level HarnessClient",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@janhq/jan": "workspace:*"
  },
  "peerDependencies": {
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-sdk-protocol": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/cordis": "workspace:~"
  },
  "devDependencies": {
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-sdk-protocol": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-experimental-translator": "workspace:*"
  }
}
