{
  "name": "@janhq/jan-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Jan SDK clients",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-goal": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-schedule": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-sdk-protocol": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-command-compact": "workspace:*",
    "@janhq/jan-command-goal": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-compaction-basic": "workspace:*",
    "@janhq/jan-goal": "workspace:*",
    "@janhq/jan-goal-round-driver": "workspace:*",
