{
  "name": "@janhq/jan-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "jan": {
    "client": {
      "inject": [
        "@janhq/jan-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@janhq/jan-deque": "workspace:*",
    "@janhq/jan-launch-environment": "workspace:*",
    "@janhq/jan-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-scope": "workspace:*"
  },
  "devDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-preset-registry": "workspace:*",
    "@janhq/jan-api-gateway": "workspace:*",
    "@janhq/jan-api-job-controller": "workspace:*",
    "@janhq/jan-api-session-controller": "workspace:*",
    "@janhq/jan-api-settings-controller": "workspace:*",
    "@janhq/jan-api-workspace-controller": "workspace:*",
    "@janhq/jan-api-workspace-files": "workspace:*",
    "@janhq/jan-client-connection": "workspace:*",
    "@janhq/jan-client-file-upload": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-cordis-host-runner": "workspace:*",
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-file-reference": "workspace:*",
    "@janhq/jan-goal": "workspace:*",
    "@janhq/jan-host-plugin-i18n": "workspace:*",
    "@janhq/jan-host-plugin-inventory": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-message-feedback": "workspace:*",
    "@janhq/jan-permission-presets": "workspace:*",
    "@janhq/jan-schedule": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-reference": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "zod": "4.6.6",
    "@janhq/jan-command-feedback": "workspace:*",
    "@janhq/jan-api-terminal-controller": "workspace:*",
    "@janhq/jan-plugin-manager": "workspace:*",
    "@janhq/jan-mcp-manager": "workspace:*",
    "@janhq/jan-plugin-market": "workspace:*",
    "@janhq/jan-client-ui-plugin-manager": "workspace:*",
    "@janhq/jan-office-to-pdf": "workspace:*",
    "@janhq/jan-api-account-controller": "workspace:*",
    "@janhq/jan-tokamak-account": "workspace:*",
    "@janhq/jan-client-product-analytics": "workspace:*",
    "@janhq/jan-agent-team": "workspace:*",
    "@janhq/jan-client-ui-trajectory": "workspace:*",
    "@janhq/jan-web": "workspace:*"
  }
}
