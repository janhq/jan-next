    "@janhq/jan-client-file-upload": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-file-reference": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-mcp-client": "workspace:*",
    "@janhq/jan-mcp-manager": "workspace:*",
    "@janhq/jan-native-command": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-session-projection-cache": "workspace:*",
    "@janhq/jan-session-query": "workspace:*",
    "@janhq/jan-session-title": "workspace:*",
    "@janhq/jan-skill": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/jan-typert-registry": "workspace:*",
    "@janhq/jan-util-time": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/jan-util-workspace-path": "workspace:*",
    "@janhq/jan-workspace": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
