{
  "name": "@janhq/jan-jobs-local",
  "description": "Process-local implementation of the Jan background job registry seam",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-jobs": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/cordis": "workspace:~"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-jobs": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/cordis": "workspace:~"
  }
}
