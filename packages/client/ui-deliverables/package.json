{
  "name": "@janhq/jan-client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "jan": {
    "client": {
      "inject": [
        "@janhq/jan-api-remotes",
        "@janhq/jan-client-connection",
        "@janhq/jan-client-locale",
        "@janhq/jan-client-ui-chat",
        "@janhq/jan-client-ui-conversation",
        "@janhq/jan-client-ui-renderer",
        "@janhq/jan-client-ui-sidebar-right",
        "@janhq/jan-client-ui-tool",
        "@janhq/jan-client-ui-settings",
        "@janhq/jan-client-ui-context-menu",
        "@janhq/jan-client-ui-layout",
        "@janhq/jan-client-ui-sidebar",
        "@janhq/jan-client-ui-workspace",
        "@janhq/jan-api-session-controller",
        "@janhq/jan-api-workspace-files"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~"
  },
  "devDependencies": {
    "@janhq/jan-api-remotes": "workspace:*",
    "@janhq/jan-client-connection": "workspace:*",
    "@janhq/jan-client-locale": "workspace:*",
    "@janhq/jan-client-store": "workspace:*",
    "@janhq/jan-client-test-runtime": "workspace:*",
    "@janhq/jan-client-ui-chat": "workspace:*",
    "@janhq/jan-client-ui-conversation": "workspace:*",
    "@janhq/jan-client-ui-dockkit": "workspace:*",
    "@janhq/jan-client-ui-renderer": "workspace:*",
    "@janhq/jan-client-ui-sidebar-right": "workspace:*",
    "@janhq/jan-client-ui-slots": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "react": "^18.2.0",
    "@janhq/jan-client-ui-primitives": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-session-query": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-client-ui-tool": "workspace:*",
    "@janhq/jan-workspace-changes": "workspace:*",
    "@janhq/jan-api-session-controller": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/jan-util-workspace-path": "workspace:*",
    "@janhq/jan-api-workspace-files": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-client-ui-settings": "workspace:*",
    "@janhq/jan-client-ui-context-menu": "workspace:*",
    "@janhq/jan-client-ui-layout": "workspace:*",
    "@janhq/jan-client-ui-sidebar": "workspace:*",
    "@janhq/jan-client-ui-workspace": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@janhq/jan-tool-present": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*"
  }
}
