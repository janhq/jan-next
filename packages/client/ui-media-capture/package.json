{
  "name": "@janhq/jan-client-ui-media-capture",
  "description": "Inline browser consent, camera and microphone capture for model requests",
  "version": "0.2.2-rc.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/client/ui-media-capture"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "imports": { "#capture-copy/*": "./locale/*" },
  "jan": {
    "client": {
      "platform": "web",
      "inject": [
        "@janhq/jan-client-locale",
        "@janhq/jan-client-ui-chat",
        "@janhq/jan-client-ui-conversation",
        "@janhq/jan-client-ui-renderer"
      ]
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "files": ["locale/*.json", "lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": { "@janhq/cordis": "workspace:~" },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-client-locale": "workspace:*",
    "@janhq/jan-client-ui-chat": "workspace:*",
    "@janhq/jan-client-ui-conversation": "workspace:*",
    "@janhq/jan-client-ui-primitives": "workspace:*",
    "@janhq/jan-client-ui-renderer": "workspace:*",
    "@janhq/jan-client-ui-slots": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-tool-capture-media": "workspace:*",
    "@janhq/jan-tool-executor-ptc": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0"
  }
}
