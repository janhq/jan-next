{
  "name": "@janhq/jan-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-mcp-resources": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-credentials": "workspace:*"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@janhq/jan-util-values": "workspace:*"
  },
  "devDependencies": {
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-attachment-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.3.0",
    "@modelcontextprotocol/node": "2.1.0",
    "zod": "4.4.3",
    "@janhq/jan-mcp-resources": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-credentials": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-mcp-resources": {
      "optional": true
    },
    "@janhq/jan-system-prompt": {
      "optional": true
    },
    "@janhq/jan-credentials": {
      "optional": true
    }
  }
}
