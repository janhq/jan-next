{
  "name": "@janhq/jan-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Jan web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-web": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-output-retention": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-spill-local": "workspace:*",
    "@janhq/jan-spill-policy": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-call-timeout-policy": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-web": "workspace:*",
    "@janhq/jan-web-fetch-http": "workspace:*",
    "@janhq/jan-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*"
  }
}
