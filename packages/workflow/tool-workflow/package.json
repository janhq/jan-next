{
  "name": "@janhq/jan-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-jobs": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-workflow": "workspace:*"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-jobs": "workspace:*",
    "@janhq/jan-jobs-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-jobs": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-workflow": "workspace:*",
    "@janhq/jan-workflow-ptc": "workspace:*"
  }
}
