    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-jobs": "workspace:*",
