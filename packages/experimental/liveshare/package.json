{
  "name": "@janhq/jan-experimental-liveshare",
  "description": "Opt-in LiveShare host bundle: share a Session through a separate Relay at the view or bounded-write tier, with forking and attachment uploads as independent switches",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/liveshare"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/share-api-types.d.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/owner-gateway/cli.js",
    "lib/retry-backoff-*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@janhq/jan-atomic-write": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-experimental-liveshare-protocol": "workspace:*",
    "@janhq/jan-http-proxy": "workspace:*",
    "@janhq/jan-official-bundles": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "undici": "8.12.2",
    "ws": "^8.18.3",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-home-paths": "workspace:*",
    "@janhq/jan-scope": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
