    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-fs-observation-policy": "workspace:*",
    "@janhq/jan-fs-sandbox": "workspace:*",
    "@janhq/jan-home-paths": "workspace:*",
    "@janhq/jan-host-webserver": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
