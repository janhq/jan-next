    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-typert-registry": "workspace:*",
    "@janhq/jan-workspace": "workspace:*",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "client": {
      "inject": [
        "@janhq/jan-api-remote-access",
        "@janhq/jan-api-remotes",
        "@janhq/jan-client-locale",
        "@janhq/jan-client-ui-conversation",
        "@janhq/jan-client-ui-primitives",
        "@janhq/jan-client-ui-renderer",
        "@janhq/jan-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
