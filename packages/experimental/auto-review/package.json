{
  "name": "@janhq/jan-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Jan Auto permission preset",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-instructions": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-permission-presets": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-util-values": "workspace:*"
  },
  "devDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-instructions": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-bash-sandbox": "workspace:*",
    "@janhq/jan-compaction": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-fs-observation-policy": "workspace:*",
    "@janhq/jan-fs-sandbox": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-permission-presets": "workspace:*",
    "@janhq/jan-ptc-runtime-node": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-shell": "workspace:*",
    "@janhq/jan-shell-env": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-bash": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-executor-ptc": "workspace:*",
    "@janhq/jan-tool-fs": "workspace:*",
    "@janhq/jan-tool-subagent": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "jan": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
