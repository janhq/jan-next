{
  "name": "@janhq/jan-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Jan extension points",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@janhq/jan-util-crypto": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-storage-domain": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-storage": "workspace:*",
    "@janhq/jan-storage-domain": "workspace:*",
    "@janhq/jan-storage-json": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-typert-protocol": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*"
  }
}
