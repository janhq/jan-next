{
  "name": "@janhq/jan-experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-browser-use": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@janhq/jan-experimental-browser-use-runtime": "workspace:*",
    "@janhq/jan-mcp-client": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@janhq/jan-subprocess": "workspace:*",
    "@puppeteer/browsers": "3.2.6"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-attachment-local": "workspace:*",
    "@janhq/jan-browser-use": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "tsx": "^4.23.13"
  }
}
