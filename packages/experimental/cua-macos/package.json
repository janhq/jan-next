{
  "name": "@janhq/jan-experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/JANComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-computer-use": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@janhq/jan-atomic-write": "workspace:*",
    "@janhq/jan-cua": "workspace:*"
  },
  "devDependencies": {
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-attachment-local": "workspace:*",
    "@janhq/jan-computer-use": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-executor-ptc": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-ptc-runtime-node": "workspace:*",
    "@janhq/jan-sandbox-local": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@janhq/jan-ptc-runtime": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-app-boot": "workspace:*",
    "@janhq/jan-config-editor": "workspace:*",
    "@janhq/jan-hmr": "workspace:*",
    "@janhq/cordis-plugin-timer": "workspace:~",
    "@janhq/jan-storage": "workspace:*",
    "@janhq/jan-storage-json": "workspace:*",
    "@janhq/jan-storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
