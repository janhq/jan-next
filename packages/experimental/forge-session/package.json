{
  "name": "@janhq/jan-experimental-forge-session",
  "description": "Binds change requests to the Session that created, pushed, or tracked them",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-experimental-forge": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-shell": "workspace:*",
    "@janhq/jan-shell-env": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-bash-local": "workspace:*",
    "@janhq/jan-experimental-forge": "workspace:*",
    "@janhq/jan-experimental-forge-github": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-shell-env": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-bash": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/jan-shell": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-shell": {
      "optional": true
    },
    "@janhq/jan-shell-env": {
      "optional": true
    },
    "@janhq/jan-tools": {
      "optional": true
    },
    "@janhq/jan-sandbox-policy": {
      "optional": true
    }
  }
}
