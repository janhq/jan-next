{
  "name": "@janhq/jan-experimental-translator",
  "description": "Machine translation with reusable Session results",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/translator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@janhq/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-app-boot": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/cordis-plugin-loader": "workspace:~"
  }
}
