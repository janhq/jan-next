{
  "name": "@janhq/jan-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "@janhq/jan-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-local": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  }
}
