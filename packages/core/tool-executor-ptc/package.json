{
  "name": "@janhq/jan-tool-executor-ptc",
  "description": "PTC program execution, tool bindings, and generated SDK prompts",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/core/tool-executor-ptc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-ptc-runtime": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-ptc-runtime": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  }
}
