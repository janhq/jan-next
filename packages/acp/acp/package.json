{
  "name": "@janhq/jan-acp",
  "description": "Automation-only Agent Client Protocol server for driving Jan agents over JSON-RPC stdio",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-mcp-client": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-attachment": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-mcp-client": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-persistence": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subagent": "workspace:*",
    "@janhq/jan-token-meter": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-approval": "workspace:*"
  }
}
