{
  "name": "@janhq/jan-llama-cpp",
  "description": "Download and verify GGUF models and supervise the bundled jan-llama-worker that serves them",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/llm/llama-cpp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "@huggingface/gguf": "^0.4.6"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent-default-model": "workspace:*",
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent-default-model": "workspace:*",
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-settings": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-agent-default-model": {
      "optional": true
    },
    "@janhq/jan-llm": {
      "optional": true
    },
    "@janhq/jan-llm-pi-ai": {
      "optional": true
    },
    "@janhq/jan-settings": {
      "optional": true
    }
  }
}
