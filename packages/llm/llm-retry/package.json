{
  "name": "@janhq/jan-llm-retry",
  "description": "Provider-routed LLM request retry policy for Jan",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-session-projection": "workspace:*"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@janhq/jan-brand": "workspace:*",
    "@janhq/cordis-plugin-include": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-mock-server": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-session-persistence-jsonl": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/cordis": "workspace:~"
  }
