{
  "name": "@janhq/jan-plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/plan/plan-mode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@janhq/jan-brand": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-ptc-runtime": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-executor-ptc": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-user-questions": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent-loop-testkit": "workspace:*"
  }
}
