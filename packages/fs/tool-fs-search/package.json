{
  "name": "@janhq/jan-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@janhq/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-output-retention": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-spill": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-output-retention": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-spill": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-timeout": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*"
  }
}
