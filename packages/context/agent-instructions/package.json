{
  "name": "@janhq/jan-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-home-paths": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-skill": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-util-values": "workspace:*",
    "@janhq/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/cordis-plugin-loader": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-commands": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-home-paths": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-llm-pi-ai": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-skill": "workspace:*",
    "@janhq/jan-system-prompt": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-fs": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  }
}
