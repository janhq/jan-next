{
  "name": "@janhq/jan-terminal-bash",
  "description": "Persistent shell PTY backend over the Jan subprocess terminal primitive",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-terminal": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "dependencies": {
    "@janhq/jan-lazy-require": "workspace:*",
    "@janhq/jan-pwsh-local": "workspace:*",
    "@janhq/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-terminal": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-working-directory": "workspace:*"
  }
}
