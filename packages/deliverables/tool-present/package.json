{
  "name": "@janhq/jan-tool-present",
  "description": "Explicit workspace file delivery declarations for Jan",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./projection": {
      "types": "./lib/types/projection.d.ts",
      "default": "./lib/types/projection.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-session": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-tool-executor-native": "workspace:*",
    "@janhq/jan-tool-testkit": "workspace:*",
    "@janhq/jan-tools": "workspace:*",
    "@janhq/jan-agent-loop": "workspace:*",
    "@janhq/jan-agent-loop-testkit": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-scope": "workspace:*",
    "@janhq/jan-working-directory": "workspace:*"
  }
}
