{
  "name": "@janhq/jan-tokamak-account",
  "description": "Authorize Tokamak accounts through the CLI device sign-in and store the minted API key",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/credentials/tokamak-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-authorization": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-host-webserver": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-util-values": "workspace:*"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-agent": "workspace:*",
    "@janhq/jan-authorization": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-credentials": "workspace:*",
    "@janhq/jan-host-webserver": "workspace:*",
    "@janhq/jan-llm": "workspace:*",
    "@janhq/jan-util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@janhq/jan-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
