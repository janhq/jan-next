{
  "name": "@janhq/jan-ssh",
  "description": "Shared OpenSSH connection and versioned POSIX remote helper",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhq/jan-next.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./helper": {
      "types": "./lib/types/helper-entry.d.ts",
      "default": "./lib/helper.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./schemas": {
      "types": "./lib/types/schemas.d.ts",
      "default": "./lib/schemas.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/helper.js",
    "lib/protocol.js",
    "lib/schemas.js",
    "lib/protocol-*.js",
    "lib/schemas-*.js",
    "lib/stream-security-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-fs-sandbox": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-local": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-util-values": "workspace:*"
  },
  "dependencies": {
    "@janhq/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@janhq/cordis": "workspace:~",
    "@janhq/jan-fs": "workspace:*",
    "@janhq/jan-fs-local": "workspace:*",
    "@janhq/jan-fs-sandbox": "workspace:*",
    "@janhq/jan-subprocess": "workspace:*",
    "@janhq/jan-subprocess-local": "workspace:*",
    "@janhq/jan-sandbox": "workspace:*",
    "@janhq/jan-sandbox-local": "workspace:*",
    "@janhq/jan-sandbox-policy": "workspace:*",
    "@janhq/jan-session-projection": "workspace:*",
    "@janhq/jan-ptc-runtime-node": "workspace:*",
    "@janhq/jan-fs-ssh": "workspace:*",
    "@janhq/jan-subprocess-ssh": "workspace:*",
    "@janhq/jan-sandbox-ssh": "workspace:*",
    "@janhq/jan-lsp": "workspace:*",
    "@janhq/jan-lsp-stdio": "workspace:*",
    "@janhq/jan-brand": "workspace:*",
    "@janhq/jan-util-values": "workspace:*"
  }
}
